configuration {
  show-icons: false;
}

/* Sonoma glass, same tokens as the other menus. */
* {
  bg: rgba(28, 28, 30, 0.60);
  bg-alt: rgba(255, 255, 255, 0.12);
  fg: rgba(255, 255, 255, 0.95);
  muted: rgba(255, 255, 255, 0.45);
  accent: #ffffff;
  selected: rgba(255, 255, 255, 0.92);
  accent-fg: #000000;
  border: rgba(255, 255, 255, 0.18);
}

window {
  width: 380px;
  border: 1px;
  border-color: @border;
  border-radius: 18px;
  background-color: @bg;
}

mainbox {
  padding: 12px;
  background-color: transparent;
  children: [ inputbar, listview ];
}

inputbar {
  padding: 8px 10px;
  margin: 0 0 8px 0;
  border: 1px;
  border-color: @border;
  border-radius: 7px;
  background-color: @bg-alt;
  children: [ prompt, entry ];
}

prompt {
  font: "Inter 12";
  text-color: @accent;
  background-color: transparent;
}

entry {
  font: "Inter 12";
  margin: 0 0 0 8px;
  text-color: @fg;
  background-color: transparent;
  placeholder: "";
  placeholder-color: @muted;
}

listview {
  lines: 8;
  spacing: 4px;
  background-color: transparent;
}

element {
  padding: 8px 11px;
  border-radius: 6px;
  background-color: transparent;
  text-color: @fg;
}

element selected {
  background-color: @selected;
  text-color: @accent-fg;
}

element-text {
  font: "Inter 12";
  text-color: inherit;
  background-color: transparent;
}
