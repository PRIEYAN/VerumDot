/**
 * Power Menu — macOS Sonoma glass, one row of five glyph buttons.
 * Matches wallpaper.rasi.
 */

configuration {
    show-icons:                 false;
}

* {
    bg-color:            rgba(28, 28, 30, 0.60);
    bg-selected:         rgba(255, 255, 255, 0.28);
    fg-color:            rgba(255, 255, 255, 0.95);
    accent-color:        #ffffff;
    border-color:        rgba(255, 255, 255, 0.18);
}

window {
    width:               800px;
    height:              180px;
    border:              1px solid;
    border-color:        @border-color;
    border-radius:       18px;
    background-color:    @bg-color;
}

mainbox {
    background-color:    transparent;
    children:            [ listview ];
}

listview {
    columns:             5;
    lines:               1;
    spacing:             20px;
    padding:             20px;
    background-color:    transparent;
}

element {
    padding:             20px;
    border-radius:       14px;
    background-color:    rgba(255, 255, 255, 0.12);
    text-color:          rgba(255, 255, 255, 0.95);
}

/* Selected fills solid white; the glyph inverts to black to stay legible. */
element selected {
    background-color:    rgba(255, 255, 255, 0.92);
    text-color:          #000000;
    border:              0px;
}

/* text-color is inherited from the element so the selected state can flip
   it to black. power-menu.sh sends bare glyphs with no Pango <span color>,
   which would otherwise override this. */
element-text {
    font:                "BlexMono Nerd Font 34";
    horizontal-align:    0.5;
    vertical-align:      0.5;
    text-color:          inherit;
    background-color:    transparent;
}
