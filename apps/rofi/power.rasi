/**
 * Power Menu — pure black, one row of five glyph buttons.
 * Matches wallpaper.rasi.
 */

configuration {
    show-icons:                 false;
}

* {
    bg-color:            #000000;
    bg-selected:         rgba(255, 255, 255, 0.16);
    fg-color:            #ffffff;
    accent-color:        #ffffff;
    border-color:        rgba(255, 255, 255, 0.14);
}

window {
    width:               800px;
    height:              180px;
    border:              1px;
    border-color:        @border-color;
    border-radius:       0px;
    background-color:    @bg-color;
}

mainbox {
    background-color:    transparent;
    children:            [ listview ];
}

listview {
    columns:             5;
    lines:               1;
    spacing:             20px;
    padding:             20px;
    background-color:    transparent;
}

element {
    padding:             20px;
    border-radius:       0px;
    background-color:    #0a0a0a;
    text-color:          #ffffff;
}

/* Selected inverts: solid white cell, black glyph. */
element selected {
    background-color:    #ffffff;
    text-color:          #000000;
    border:              0px;
}

/* text-color is inherited from the element so the selected state can flip
   it to black. power-menu.sh sends bare glyphs with no Pango <span color>,
   which would otherwise override this. */
element-text {
    font:                "BlexMono Nerd Font 34";
    horizontal-align:    0.5;
    vertical-align:      0.5;
    text-color:          inherit;
    background-color:    transparent;
}
