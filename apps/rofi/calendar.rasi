/* Calendar dropdown — pure black / white, under waybar clock */

configuration {
    show-icons:          false;
    disable-history:     true;
    hover-select:        true;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
}

* {
    bg:                 rgba(0, 0, 0, 0.62);   /* glass: blurred by the rofi layerrule */
    fg:                 #ffffff;
    muted:              rgba(255, 255, 255, 0.40);
    accent:             #ffffff;
    accent-fg:          #000000;
    line:               rgba(255, 255, 255, 0.18);

    background-color:   transparent;
    text-color:         @fg;
    font:               "Iosevka Term 10";
}

window {
    transparency:       "real";
    location:           north west;
    anchor:             north west;
    x-offset:           0px;
    y-offset:           0px;
    width:              280px;
    border:             1px solid;
    border-color:       rgba(255, 255, 255, 0.22);
    border-radius:      0px;
    background-color:   @bg;
    children:           [ mainbox ];
}

mainbox {
    padding:            14px 16px 12px 16px;
    spacing:            8px;
    background-color:   transparent;
    children:           [ inputbar, message, listview, footer ];
}

inputbar {
    spacing:            0px;
    padding:            0px 0px 4px 0px;
    background-color:   transparent;
    children:           [ prompt ];
}

prompt {
    enabled:            true;
    expand:             true;
    horizontal-align:   0.5;
    text-color:         @fg;
    font:               "Iosevka Term Medium 11";
    background-color:   transparent;
}

entry {
    enabled:            false;
}

message {
    padding:            0px 0px 2px 0px;
    background-color:   transparent;
    border:             0px;
}

textbox {
    horizontal-align:   0.5;
    text-color:         @fg;
    background-color:   transparent;
    font:               "Iosevka Term Medium 10";
    markup:             true;
}

listview {
    columns:            7;
    lines:              6;
    cycle:              false;
    dynamic:            false;
    fixed-height:       true;
    fixed-columns:      true;
    flow:               horizontal;
    scrollbar:          false;
    spacing:            2px;
    padding:            2px 0px;
    background-color:   transparent;
}

element {
    orientation:        horizontal;
    padding:            6px 0px;
    border-radius:      2px;
    background-color:   transparent;
    text-color:         @fg;
    cursor:             pointer;
}

element normal.normal,
element alternate.normal {
    background-color:   transparent;
    text-color:         @fg;
}

element normal.urgent,
element alternate.urgent {
    background-color:   transparent;
    text-color:         @muted;
}

element selected.normal {
    background-color:   @accent;
    text-color:         @accent-fg;
}

element selected.urgent {
    background-color:   transparent;
    text-color:         @muted;
}

element-text {
    horizontal-align:   0.5;
    vertical-align:     0.5;
    text-color:         inherit;
    background-color:   transparent;
    font:               "Iosevka Term 10";
    markup:             true;
}

footer {
    orientation:        horizontal;
    expand:             false;
    spacing:            0px;
    margin:             6px 0px 0px 0px;
    padding:            8px 0px 0px 0px;
    border:             1px 0px 0px 0px;
    border-color:       @line;
    background-color:   transparent;
    children:           [ textbox-footer ];
}

textbox-footer {
    expand:             true;
    horizontal-align:   0.5;
    text-color:         @muted;
    background-color:   transparent;
    font:               "Iosevka Term 9";
    str:                "↔ mo   ↕ yr   ↵ today";
}
