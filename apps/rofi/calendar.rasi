/* Calendar — macOS Sonoma floating glass sheet, under the waybar clock.
   Blur comes from the `rofi` layerrule in hypr.conf; this file only supplies
   the translucent material on top of it. */

configuration {
    show-icons:          false;
    disable-history:     true;
    hover-select:        true;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
}

* {
    surface:            rgba(28, 28, 30, 0.60);
    raised:             rgba(255, 255, 255, 0.12);
    line:               rgba(255, 255, 255, 0.18);
    hover:              rgba(255, 255, 255, 0.08);
    fg:                 rgba(255, 255, 255, 0.95);
    muted:              rgba(255, 255, 255, 0.70);
    faint:              rgba(255, 255, 255, 0.45);
    accent:             #ffffff;

    background-color:   transparent;
    text-color:         @fg;
    font:               "Inter 10";
}

window {
    transparency:       "real";
    location:           north west;
    anchor:             north west;
    /* Left edge flush with the waybar island, whose side margin is 6px
       (apps/waybar/config.jsonc, "margin": "4 6 0 6"). */
    x-offset:           6px;
    y-offset:           0px;
    width:              304px;
    border:             1px solid;
    border-color:       @line;
    /* Square where it meets the bar, rounded below. */
    border-radius:      0px 0px 20px 20px;
    background-color:   @surface;
    children:           [ mainbox ];
}

mainbox {
    padding:            16px 18px 14px 18px;
    spacing:            10px;
    background-color:   transparent;
    children:           [ inputbar, listview, footer ];
}

inputbar {
    spacing:            0px;
    padding:            0px 0px 6px 0px;
    background-color:   transparent;
    children:           [ prompt ];
}

/* Month / year header */
prompt {
    enabled:            true;
    expand:             true;
    horizontal-align:   0.5;
    text-color:         @fg;
    font:               "Inter Medium 12";
    background-color:   transparent;
}

entry {
    enabled:            false;
}

textbox {
    horizontal-align:   0.5;
    text-color:         @fg;
    background-color:   transparent;
    font:               "Inter Medium 10";
    markup:             true;
}

listview {
    columns:            7;
    lines:              7;
    cycle:              false;
    dynamic:            false;
    fixed-height:       true;
    fixed-columns:      true;
    flow:               horizontal;
    scrollbar:          false;
    spacing:            3px;
    padding:            4px 0px;
    background-color:   transparent;
}

element {
    orientation:        horizontal;
    padding:            7px 0px;
    border-radius:      9px;
    background-color:   transparent;
    text-color:         @fg;
    cursor:             pointer;
}

element normal.normal,
element alternate.normal {
    background-color:   transparent;
    text-color:         @fg;
}

/* Weekday header row (marked urgent by the script) — muted, never highlights. */
element normal.urgent,
element alternate.urgent {
    background-color:   transparent;
    text-color:         @faint;
}

/* Hovered / selected day: a filled white pill, text inverted to black. */
element selected.normal {
    background-color:   rgba(255, 255, 255, 0.92);
    text-color:         #000000;
}

element selected.urgent {
    background-color:   transparent;
    text-color:         @faint;
}

element-text {
    horizontal-align:   0.5;
    vertical-align:     0.5;
    text-color:         inherit;
    background-color:   transparent;
    font:               "Inter 10";
    markup:             true;
}

footer {
    orientation:        horizontal;
    expand:             false;
    spacing:            0px;
    margin:             8px 0px 0px 0px;
    padding:            10px 0px 0px 0px;
    border:             1px 0px 0px 0px;
    border-color:       @line;
    background-color:   transparent;
    children:           [ textbox-footer ];
}

textbox-footer {
    expand:             true;
    horizontal-align:   0.5;
    text-color:         @faint;
    background-color:   transparent;
    font:               "Inter 9";
    str:                "↔ mo   ↕ yr   ↵ today";
}
